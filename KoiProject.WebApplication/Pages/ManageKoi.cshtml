@page
<h2>Quản lý cá Koi</h2>
<form method="post">
    <div>
        <label for="koiName">Tên cá Koi:</label>
        <input type="text" id="koiName" name="koiName" />
    </div>
    <div>
        <label for="koiSize">Kích thước (cm):</label>
        <input type="number" id="koiSize" name="koiSize" />
    </div>
    <button type="submit">Lưu</button>
</form>

