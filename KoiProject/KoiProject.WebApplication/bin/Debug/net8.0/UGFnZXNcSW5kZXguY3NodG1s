@page
@{
    ViewData["Title"] = "Live Show Hình Ảnh";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>

    <div class="slideshow-container">
        <div class="slide-track">
            <div class="slide">
                <img src="~/Images/banner1.jpg" style="width:100%">
            </div>

            <div class="slide">
                <img src="~/Images/banner2.jpg" style="width:100%">
            </div>

            <div class="slide">
                <img src="~/Images/banner3.jpg" style="width:100%">
            </div>
        </div>
    </div>
    <!-- Phần giới thiệu cuộc thi -->
    <div class="introduction-container">
        <!-- Cột nội dung -->
        <div class="introduction-content">
            <h2>Giới thiệu Cuộc Thi</h2>

            <!-- Mục Tổng quan -->
            <div class="section">
                <h3>Tổng quan</h3>
                <p>
                    Cuộc thi cá Koi là sự kiện thường niên thu hút nhiều người yêu thích cá Koi từ khắp nơi. Cuộc thi nhằm tạo sân chơi và cơ hội để các nhà sưu tập và người nuôi cá Koi chia sẻ kinh nghiệm, trình diễn những chú cá đẹp nhất của mình.
                </p>

                <!-- Danh sách các điểm nổi bật -->
                <ul>
                    <li>Hơn 500 người tham gia mỗi năm.</li>
                    <li>Trình diễn hơn 300 chú cá Koi từ các nhà sưu tập nổi tiếng.</li>
                    <li>Chia sẻ kiến thức nuôi và chăm sóc cá Koi giữa các chuyên gia.</li>
                    <li>Các hoạt động vui chơi và giải trí dành cho gia đình và trẻ em.</li>
                    <li>Giao lưu với các nhà sản xuất thức ăn và thiết bị nuôi cá Koi.</li>
                </ul>
            </div>

            <!-- Mục Mục tiêu -->
            <div class="section">
                <h3>Mục tiêu</h3>
                <p>
                    Mục tiêu chính của cuộc thi là tôn vinh vẻ đẹp và giá trị của loài cá Koi, thúc đẩy phong trào nuôi cá Koi và tạo môi trường giao lưu cho những người đam mê cá cảnh.
                </p>
            </div>

            <!-- Mục Nội dung -->
            <div class="section">
                <h3>Nội dung</h3>
                <p>
                    Cuộc thi bao gồm các hạng mục tranh tài dựa trên màu sắc, kích thước, hình dáng và sự khỏe mạnh của cá Koi. Người tham gia có thể đăng ký và gửi hình ảnh hoặc video cá Koi của mình để dự thi.
                </p>
            </div>
        </div>

        <!-- Cột hình ảnh -->
        <div class="introduction-image">
            <img src="~/Images/3c1e369ab35c5b57c486a3c2a1535301.jpg" alt="Cuộc thi Cá Koi" />
        </div>
    </div>

    <!-- Phần Thông tin về giải thưởng -->
    <div class="award-container">
        <!-- Cột nội dung -->
        <div class="award-content">
            <h2>Thông tin về Giải Thưởng</h2>

            <!-- Hạng mục giải thưởng -->
            <div class="section">
                <h3>Các hạng mục giải thưởng</h3>
                <ul>
                    <li>Giải Grand Champion: Dành cho chú cá Koi có điểm tổng cao nhất.</li>
                    <li>Giải Sakura Champion: Dành cho cá Koi có màu sắc ấn tượng nhất.</li>
                    <li>Giải Mature Champion: Dành cho cá Koi trưởng thành đẹp nhất.</li>
                    <li>Giải Young Champion: Dành cho cá Koi trẻ dưới 3 tuổi.</li>
                    <li>Giải Baby Champion: Dành cho cá Koi nhỏ dưới 1 tuổi.</li>
                </ul>
            </div>

            <!-- Tiêu chí chấm điểm -->
            <div class="section">
                <h3>Tiêu chí chấm điểm</h3>
                <ul>
                    <li>50% Dáng: Dáng bơi và sự cân đối của thân cá.</li>
                    <li>30% Màu sắc: Độ tươi sáng và phân bố màu sắc.</li>
                    <li>20% Hoa văn: Sự phân bố và cân đối của các hoa văn trên cá.</li>
                </ul>
            </div>

            <!-- Giá trị giải thưởng -->
            <div class="section">
                <h3>Giá trị giải thưởng</h3>
                <p>
                    Các giải thưởng bao gồm cúp, huy chương và các phần thưởng tiền mặt. Giải Grand Champion sẽ nhận được giải thưởng lớn nhất trị giá 100 triệu đồng, cùng với cúp vàng danh giá.
                </p>
            </div>
        </div>

        <!-- Cột hình ảnh -->
        <div class="award-image">
            <img src="~/Images/giaithuong.jpg" alt="Giải thưởng Cá Koi" />
        </div>
    </div>

    <!-- Phần thông tin về Luật Thi Đấu -->
    <div class="rules-container">
        <!-- Cột nội dung -->
        <div class="rules-content">
            <h2>Thông tin về Luật Thi Đấu</h2>

            <!-- Quy định thi đấu -->
            <div class="section">
                <h3>Quy định thi đấu</h3>
                <ul>
                    <li>Người tham gia phải đăng ký trước thời hạn và cung cấp đầy đủ thông tin về cá Koi tham gia.</li>
                    <li>Cá Koi phải được kiểm tra sức khỏe trước khi tham gia thi đấu.</li>
                    <li>Không được phép can thiệp vào hồ cá của đối thủ trong quá trình thi đấu.</li>
                    <li>Không sử dụng bất kỳ chất hóa học nào để làm thay đổi màu sắc hoặc dáng bơi của cá.</li>
                    <li>Người tham gia phải tuân thủ các quy định về bảo vệ môi trường và chăm sóc cá.</li>
                </ul>
            </div>

            <!-- Tiêu chí chấm điểm -->
            <div class="section">
                <h3>Tiêu chí chấm điểm</h3>
                <ul>
                    <li>50% Dáng bơi: Đánh giá sự cân đối và uyển chuyển của dáng bơi cá Koi.</li>
                    <li>30% Màu sắc: Đánh giá độ tươi sáng, sự đồng đều và phân bố màu sắc trên cơ thể cá.</li>
                    <li>20% Hoa văn: Sự cân đối và hài hòa của hoa văn trên cá Koi.</li>
                </ul>
            </div>
        </div>

        <!-- Cột hình ảnh -->
        <div class="rules-image">
            <img src="~/Images/LuatThiDau.jpg" alt="Luật thi đấu cá Koi" />
        </div>
    </div>
    <!-- Phần tin tức và cập nhật -->
    <div class="news-updates">
        <h2>Tin tức và Cập nhật</h2>
        <p>Cập nhật những tin tức mới nhất liên quan đến cuộc thi.</p>
        <ul>
            <li><a href="#">Thay đổi lịch trình cuộc thi cá Koi 2024</a></li>
            <li><a href="#">Phỏng vấn ban giám khảo cuộc thi cá Koi</a></li>
            <li><a href="#">Bài viết về những chú cá Koi nổi bật nhất</a></li>
        </ul>
        <p><a href="#">Tài liệu tham khảo về chăm sóc và nuôi cá Koi</a></p>
    </div>

    <!-- Chức năng đăng ký nhanh -->
    <div class="quick-registration">
        <h2>Đăng ký nhanh</h2>
        <form>
            <input type="text" placeholder="Họ và tên" required>
            <input type="email" placeholder="Email" required>
            <button type="submit">Đăng ký ngay</button>
        </form>
        <p><a href="#">Đăng ký chi tiết</a></p>
    </div>

    <!-- Đếm ngược thời gian -->
    <div class="countdown">
        <h2>Đếm ngược đến ngày thi đấu</h2>
        <div id="timer">
            <span id="days"></span> Ngày
            <span id="hours"></span> Giờ
            <span id="minutes"></span> Phút
            <span id="seconds"></span> Giây
        </div>
    </div>

    <!-- Câu hỏi thường gặp (FAQ) -->
    <div class="faq">
        <h2>Câu hỏi thường gặp</h2>
        <ul>
            <li><strong>Làm sao để đăng ký cá Koi?</strong> Bạn có thể đăng ký qua form đăng ký nhanh trên trang chủ.</li>
            <li><strong>Có chi phí tham gia không?</strong> Cuộc thi có phí tham gia tùy vào từng hạng mục.</li>
            <li><strong>Các tiêu chí chấm điểm là gì?</strong> Dáng bơi, màu sắc và hoa văn của cá Koi.</li>
        </ul>
    </div>

    <!-- Phần liên hệ (footer) -->
    <footer>
        <h2>Liên hệ với chúng tôi</h2>
        <p>Email: <a href="mailto:contact@koishow.com">contact@koishow.com</a></p>
        <p>Số điện thoại: <a href="tel:+84987654321">+84 987 654 321</a></p>
        <p>Theo dõi chúng tôi trên mạng xã hội:</p>
        <div class="social-links">
            <a href="#">Facebook</a>
            <a href="#">Instagram</a>
        </div>
    </footer>

    <script src="~/js/countdown.js"></script>
</body>
</html>