<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Cuộc thi cá Koi</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Style.css" />

</head>
<body>
    <div class="header">
        <div class="header_logo">
            <img src="~/Images/LOGO-removebg-preview.png" alt="Logo">
        </div>
        <div class="nav_menu">
            <ul>
                <li><a href="/Index">Trang Chủ</a></li>
                <li><a href="/DetailsCompetition">Chi tiết Các cuộc thi</a></li>
                <li><a href="/ManageKoi">Quản lý cá Koi</a></li>
                <li><a href="/Results">Kết Quả</a></li>
                <li><a href="/CompetitionProgress">Quá Trình thi Đấu</a></li>
                <li><a href="/Login">Đăng Nhập</a></li>
                <li><a href="/Report">Báo Cáo</a></li>
                <!-- Thêm các mục khác nếu cần -->
            </ul>
        </div>
    </div>


    <div class="container">
        @RenderBody()  <!-- Nội dung các trang cụ thể sẽ được chèn tại đây -->
    </div>

    <footer class="text-center mt-5">
        <p>&copy; <script>document.write(new Date().getFullYear());</script> Cuộc thi cá Koi</p>
    </footer>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>
