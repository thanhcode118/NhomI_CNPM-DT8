@page
@{
    Layout = null;
    ViewData["Title"] = "Competitions";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý cuộc thi cá Koi</title>
    <link rel="stylesheet" href="/css/cssCompetition/styles.css">
</head>
<body>
    <header class="header">
        <div class="header-overlay">
            <div class="header-content">
                <h1>Quản lý cuộc thi triển lãm cá Koi</h1>
                <p>Chào mừng bạn đến với hệ thống quản lý cuộc thi cá Koi chuyên nghiệp, nơi các cá thể đẹp nhất hội tụ.</p>
                <a asp-page="/RankingKoiCompetition" class="btn-primary">Bắt đầu ngay</a>

            </div>
        </div>
    </header>

    <nav class="navbar">
        <ul>
            <li><a href="#register">Đăng ký cá Koi</a></li>
            <li><a href="#categorize">Phân loại</a></li>
            <li><a href="#checkin">Check-in</a></li>
            <li><a href="#results">Kết quả</a></li>
        </ul>
    </nav>

    <main class="main-content">
        <section id="register" class="section">
            <h2>Đăng ký cá Koi</h2>
            <p class="section-description">Nhập thông tin cá Koi của bạn để đăng ký tham gia cuộc thi.</p>
            <form class="form">
                <div class="form-group">
                    <label for="fishName">Tên cá Koi:</label>
                    <input type="text" id="fishName" name="fishName" placeholder="Nhập tên cá Koi" required>
                </div>

                <div class="form-group">
                    <label for="variety">Giống:</label>
                    <select id="variety" name="variety">
                        <option value="kohaku">Kohaku</option>
                        <option value="sanke">Sanke</option>
                        <option value="showa">Showa</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="size">Kích thước (cm):</label>
                    <input type="number" id="size" name="size" placeholder="Nhập kích thước" required>
                </div>

                <div class="form-group">
                    <label for="age">Độ tuổi:</label>
                    <input type="number" id="age" name="age" placeholder="Nhập tuổi cá" required>
                </div>

                <button type="submit" class="btn-primary">Đăng ký</button>
            </form>
        </section>

        <section id="categorize" class="section">
            <h2>Phân loại</h2>
            <p class="section-description">Hệ thống tự động phân loại cá Koi vào các hạng mục dựa trên giống, kích thước và tuổi.</p>
            <div class="image-box">
                <a asp-page="/KoiClassification" class="btn-primary">Phân loại cá Koi</a>
            </div>
        </section>


        <section id="checkin" class="section">
            <h2>Check-in</h2>
            <p class="section-description">Thí sinh check-in tại khu vực thi để xác nhận tham gia.</p>
            <a asp-page="/CheckIn" class="btn-primary">Check-in ngay</a>
        </section>


        <section id="results" class="section">
            <h2>Check-in</h2>
            <p class="section-description">Cập nhật kết quả cuộc thi, tính điểm từ các giám khảo và công bố kết quả chung cuộc.</p>
            <a asp-page="/RankingKoiCompetition" class="btn-primary">Cập nhật kết quả</a>
        </section>

    </main>

    <footer class="footer">
        <p>&copy; 2024 Cuộc thi triển lãm cá Koi. Designed with ❤ by DevTeam</p>
    </footer>
</body>
</html>
