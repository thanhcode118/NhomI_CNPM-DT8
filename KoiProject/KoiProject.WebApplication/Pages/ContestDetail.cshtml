          </div>
        </div>
        <div class="col-lg-3">
          <div class="contest-item">
            <div class="top-content">
              <span class="award">Award Price</span>
              <span class="price">$3,600</span>
            </div>
            <img src="assets/assetsDetail/images/contest-03.jpg" alt="">
            <h4>Walk In The Nature Night</h4>
            <div class="info">
              <span class="participants"><img src="vendors/vendorDetail/images/icon-03.png" alt=""><br>55 Participants</span>
              <span class="submittions"><img src="vendors/vendorDetail/images/icon-01.png" alt=""><br>150 Submissions</span>
            </div>
            <div class="border-button">
              <a href="/html/contest-details.html">Browse Nature Pic Contests</a>
            </div>
            <span class="info">* Client will pay via Online Payments</span>
          </div>
        </div>
        <div class="col-lg-3">
          <div class="contest-item">
            <div class="top-content">
              <span class="award">Award Price</span>
              <span class="price">$4,800</span>
            </div>
            <img src="assets/assetsDetail/images/contest-04.jpg" alt="">
            <h4>Walk In The Nature Night</h4>
            <div class="info">
              <span class="participants"><img src="vendors/vendorDetail/images/icon-03.png" alt=""><br>40 Participants</span>
              <span class="submittions"><img src="vendors/vendorDetail/images/icon-01.png" alt=""><br>120 Submissions</span>
            </div>
            <div class="border-button">
              <a href="/html/contest-details.html">Browse Nature Pic Contests</a>
            </div>
            <span class="info">* Client will pay via Online Payments</span>
          </div>
        </div>
        <div class="col-lg-12">
          <ul class="pagination">
            <li><a href="#"><i class="fa fa-arrow-left"></i></a></li>
            <li><a href="#">1</a></li>
            <li class="active"><a href="#">2</a></li>
            <li><a href="#">3</a></li>
            <li><a href="#"><i class="fa fa-arrow-right"></i></a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <p>Copyright ©2024 <a href="#">SnapX</a> Photo Contest Co., Ltd. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <!-- Bootstrap core JavaScript -->
  <script src="/vendors/vendorDetail/jquery/jquery.min.js"></script>
  <script src="/vendors/vendorDetail/bootstrap/js/bootstrap.min.js"></script>

  <script src="/assets/assetsDetail/js/isotope.min.js"></script>
  <script src="/assets/assetsDetail/js/owl-carousel.js"></script>

  <script src="/assets/assetsDetail/js/tabs.js"></script>
  <script src="/assets/assetsDetail/js/popup.js"></script>
  <script src="/assets/assetsDetail/js/custom.js"></script>

</body>

</html>