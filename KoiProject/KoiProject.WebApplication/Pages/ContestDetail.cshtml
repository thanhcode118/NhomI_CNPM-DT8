            <div class="info">
              <span class="participants"><img src="vendors/vendorDetail/images/icon-03.png" alt=""><br>60 Participants</span>
              <span class="submittions"><img src="vendors/vendorDetail/images/icon-01.png" alt=""><br>212 Submissions</span>
            </div>
            <div class="border-button">
