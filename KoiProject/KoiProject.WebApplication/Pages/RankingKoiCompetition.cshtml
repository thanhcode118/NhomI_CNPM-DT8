@page
@model KoiProject.WebApplication.Pages.RankingCompetitionModel
@{
    ViewData["Title"] = "Koi Competition Rankings";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header class="bg-primary text-white text-center py-4">
        <h1>Quản lý cuộc thi triển lãm cá Koi</h1>
        <p class="lead">Bảng xếp hạng kết quả cuộc thi</p>
    </header>

    <main class="container mt-5">
        <h2 class="text-center">Koi Competition Rankings</h2>
        <table class="table table-hover mt-4">
            <thead class="table-dark">
                <tr>
                    <th>Rank</th>
                    <th>Name</th>
                    <th>Breed</th>
                    <th>Size (cm)</th>
                    <th>Color</th>
                    <th>Origin</th>
                    <th>GPA</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rankings != null && Model.Rankings.Any())
                {
                    int rank = 1;
                    foreach (var koi in Model.Rankings)
                    {
                        <tr>
                            <td>@rank</td>
                            <td>@koi.Name</td>
                            <td>@koi.Breed</td>
                            <td>@koi.Size</td>
                            <td>@koi.Color</td>
                            <td>@koi.Origin</td>
                            <td>@koi.Gpa</td>
                        </tr>
                        rank++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No data available</td>
                    </tr>
                }
            </tbody>
        </table>
    </main>

    <footer class="bg-dark text-white text-center py-3">
        <p>&copy; 2024 Cuộc thi triển lãm cá Koi. Designed by DevTeam</p>
    </footer>
</body>
</html>
