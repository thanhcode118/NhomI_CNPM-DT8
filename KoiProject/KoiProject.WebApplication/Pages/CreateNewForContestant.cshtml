@page
@model CreateNewForContestantModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html :class="{ 'theme-dark': dark }" x-data="data()" lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account - Windmill Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/assetsCreate/assets/css/tailwind.output.css" />
    <script src="https://cdn.jsdelivr.net/gh/alpinejs/alpine@v2.x.x/dist/alpine.min.js"
            defer></script>
    <script src="~/assetsCreate/assets/js/init-alpine.js"></script>
</head>
<body>
    <div class="flex items-center min-h-screen p-6 bg-gray-50 dark:bg-gray-900">
        <div class="flex-1 h-full max-w-4xl mx-auto overflow-hidden bg-white rounded-lg shadow-xl dark:bg-gray-800">
            <div class="flex flex-col overflow-y-auto md:flex-row">
                <div class="h-32 md:h-auto md:w-1/2">
                    <img aria-hidden="true"
                         class="object-cover w-full h-full dark:hidden"
                         src="~/assetsCreate/assets/img/create-account-office.jpeg"
                         alt="Office" />
                    <img aria-hidden="true"
                         class="hidden object-cover w-full h-full dark:block"
                         src="~/img/create_new.jpg"
                         alt="Koi" />
                </div>
                <div class="flex items-center justify-center p-6 sm:p-12 md:w-1/2">
                    <div class="w-full">
                        <h1 class="mb-4 text-xl font-semibold text-gray-700 dark:text-gray-200">
                            ĐĂNG KÍ THAM GIA CUỘC THI
                        </h1>
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success text-green-700 bg-green-100 border border-green-400 p-2 rounded mb-4">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        <!-- Hiển thị thông báo lỗi -->
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger text-red-700 bg-red-100 border border-red-400 p-2 rounded mb-4">
                                @ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage
                            </div>
                        }

                        <!-- Employee Name -->
                        <!--<label class="block text-sm">    <span class="text-gray-700 dark:text-gray-400">Tên Nhân </span>
                                <input class="block w-full mt-1 text-sm dark:border-gray-600 dark:bg-gray-700 focus:border-purple-400 focus:outline-none focus:shadow-outline-purple dark:text-gray-300 dark:focus:shadow-outline-gray form-input"
                                       placeholder="Nguyễn Văn A"
                                       type="text" />
                            </label>-->

                        <!-- Department
                        <label class="block mt-4 text-sm">
                                                    <span class="text-gray-700 dark:text-gray-400">Bộ Phận</span>
                                                    <select class="block w-full mt-1 text-sm dark:border-gray-600 dark:bg-gray-700 focus:border-purple-400 focus:outline-none focus:shadow-outline-purple dark:text-gray-300 dark:focus:shadow-outline-gray form-select">
                                                        <option>Bán Vé</option>
                                                        <option>Kiểm Soát Vé</option>
                                                        <option>Quầy Đồ Ăn</option>
                                                        <option>Dọn Dẹp</option>
                                                    </select>
                                                </label>
                                                -->
                        

                        <!-- Shift -->
                        <label class="block mt-4 text-sm">
                            <span class="text-gray-700 dark:text-gray-400">Danh sách cá</span>
                            <select class="block w-full mt-1 text-sm dark:border-gray-600 dark:bg-gray-700 focus:border-purple-400 focus:outline-none focus:shadow-outline-purple dark:text-gray-300 dark:focus:shadow-outline-gray form-select">
                                @if (Model.KoiList == null || !Model.KoiList.Any())
                                {
                                    <p class="text-red-500">Không có Cá Koi nào sẵn sàng tham gia.</p>
                                }
                                else
                                {


                                    @foreach (var koi in Model.KoiList)
                                    {
                                        <option value="@koi.KoiId">@koi.Name - @koi.Breed - @koi.Size cm</option>
                                    }
                                }
                            </select>
                        </label>

                        <!-- Salary -->
                        <!-- <label class="block mt-4 text-sm">
                            <span class="text-gray-700 dark:text-gray-400">Lương</span>
                            <input class="block w-full mt-1 text-sm dark:border-gray-600 dark:bg-gray-700 focus:border-purple-400 focus:outline-none focus:shadow-outline-purple dark:text-gray-300 dark:focus:shadow-outline-gray form-input"
                                   placeholder="8,000,000 VNĐ"
                                   type="text" />
                        </label>-->

                        <!-- Email -->
                        <label class="block mt-4 text-sm">
                            <span class="text-gray-700 dark:text-gray-400">Email</span>
                            <input class="block w-full mt-1 text-sm dark:border-gray-600 dark:bg-gray-700 focus:border-purple-400 focus:outline-none focus:shadow-outline-purple dark:text-gray-300 dark:focus:shadow-outline-gray form-input"
                                   placeholder="email@example.com"
                                   type="email" />
                        </label>

                        <!-- Password -->
                        <!--  <label class="block mt-4 text-sm">
                            <span class="text-gray-700 dark:text-gray-400">Mật Khẩu</span>
                            <input class="block w-full mt-1 text-sm dark:border-gray-600 dark:bg-gray-700 focus:border-purple-400 focus:outline-none focus:shadow-outline-purple dark:text-gray-300 dark:focus:shadow-outline-gray form-input"
                                   placeholder="***************"
                                   type="password" />
                        </label>-->

                        <!-- Confirm Password -->
                        <!--<label class="block mt-4 text-sm">
                            <span class="text-gray-700 dark:text-gray-400">Xác Nhận Mật Khẩu</span>
                            <input class="block w-full mt-1 text-sm dark:border-gray-600 dark:bg-gray-700 focus:border-purple-400 focus:outline-none focus:shadow-outline-purple dark:text-gray-300 dark:focus:shadow-outline-gray form-input"
                                   placeholder="***************"
                                   type="password" />
                        </label>-->

                        <!-- Agreement Checkbox -->
                        <div class="flex mt-6 text-sm">
                            <label class="flex items-center dark:text-gray-400">
                                <input type="checkbox"
                                       class="text-purple-600 form-checkbox focus:border-purple-400 focus:outline-none focus:shadow-outline-purple dark:focus:shadow-outline-gray" />
                                <span class="ml-2">
                                    Tôi đồng ý với <span class="underline">chính sách bảo mật</span>
                                </span>
                            </label>
                        </div>

                        <!-- Submit Button -->
                        <button class="block w-full px-4 py-2 mt-4 text-sm font-medium leading-5 text-center text-white transition-colors duration-150 bg-purple-600 border border-transparent rounded-lg active:bg-purple-600 hover:bg-purple-700 focus:outline-none focus:shadow-outline-purple"
                                type="submit">
                            Tham gia ngay
                        </button>  
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>
</html>

