@page
@model CreateNewContestantModel
@{
    Layout = null;
}

<div class="container">
    <h1>Đăng ký cá Koi</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <form method="post">
        <div>
            <label for="KoiName">Tên cá Koi</label>
            <input asp-for="KoiName" />
        </div>

        <div>
            <label for="KoiBreed">Giống cá Koi</label>
            <input asp-for="KoiBreed" />
        </div>

        <div>
            <label for="KoiSize">Kích thước</label>
            <input asp-for="KoiSize" type="number" />
        </div>

        <div>
            <label for="KoiColor">Màu sắc</label>
            <input asp-for="KoiColor" />
        </div>

        <div>
            <label for="KoiGPA">GPA</label>
            <input asp-for="KoiGPA" type="number" step="0.01" />
        </div>

        <div>
            <label for="Email">Email</label>
            <input asp-for="Email" type="email" />
        </div>

        <button type="submit">Đăng ký</button>
    </form>
</div>
