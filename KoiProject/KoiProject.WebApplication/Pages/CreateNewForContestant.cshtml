@page
@model CreateNewForContestantModel
@{
    Layout = null;
}

<div class="flex items-center min-h-screen p-6 bg-gray-50 dark:bg-gray-900">
    <div class="flex-1 max-w-4xl mx-auto bg-white rounded-lg shadow-xl dark:bg-gray-800">
        <div class="flex flex-col md:flex-row">
            <div class="md:w-1/2">
                <img src="~/img/create_new.jpg" alt="Koi Contest" class="w-full h-full object-cover">
            </div>
            <div class="md:w-1/2 p-6">
                <h1 class="text-xl font-semibold text-gray-700 dark:text-gray-200 mb-4">Đăng Ký Tham Gia Cuộc Thi</h1>

                <!-- Hiển thị thông báo thành công -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-green-700 bg-green-100 border border-green-400 p-2 rounded mb-4">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <!-- Hiển thị thông báo lỗi -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger text-red-700 bg-red-100 border border-red-400 p-2 rounded mb-4">
                        @ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage
                    </div>
                }

                <form method="post">
                    <label class="block text-sm mt-4">
                        <span class="text-gray-700">Chọn Cá Koi</span>
                        <select class="form-select w-full p-2 border border-gray-300 rounded" asp-for="Contestant.KoiId">
                            @if (Model.KoiList == null || !Model.KoiList.Any())
                            {
                                <p class="text-red-500">Không có Cá Koi nào sẵn sàng tham gia.</p>
                            }
                            else
                            {
                            

                            @foreach (var koi in Model.KoiList)
                            {
                                <option value="@koi.KoiId">@koi.Name - @koi.Breed - @koi.Size cm</option>
                            }
                            }
                        </select>
                        <span asp-validation-for="Contestant.KoiId" class="text-red-500 text-sm"></span>
                    </label>

                    <label class="block text-sm mt-4">
                        <span class="text-gray-700">Email</span>
                        <input class="form-input w-full p-2 border border-gray-300 rounded" type="email" asp-for="Contestant.Email" />
                        <span asp-validation-for="Contestant.Email" class="text-red-500 text-sm"></span>
                    </label>

                    <button class="mt-6 w-full bg-purple-600 text-white px-4 py-2 rounded" type="submit">
                        Đăng Ký
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
