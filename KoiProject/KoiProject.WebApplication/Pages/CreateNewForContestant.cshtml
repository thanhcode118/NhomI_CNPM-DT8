@page
@model CreateNewContestantModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký Cá Koi";
}

<!DOCTYPE html>
<html :class="{ 'theme-dark': dark }" x-data="data()" lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Windmill Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/assetsCreate/assets/css/tailwind.output.css" />
    <script src="https://cdn.jsdelivr.net/gh/alpinejs/alpine@v2.x.x/dist/alpine.min.js" defer></script>
    <script src="~/assetsCreate/assets/js/init-alpine.js"></script>
    <style>
        body {
            background-color: #ffffff;
            color: #1f2937;
        }

        .dark:bg-gray-900 {
            background-color: #ffffff !important;
        }

        .bg-gray-50 {
            background-color: #ffffff !important;
        }

        .rounded-lg {
            background-color: #ffffff;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #1a202c;
            font-family: 'Inter', sans-serif;
        }

        label span {
            font-size: 1rem;
            font-weight: 600;
            color: #2d3748;
        }

        input, textarea, select {
            font-size: 1rem;
            border-radius: 0.375rem;
            border: 1px solid #cbd5e0;
            padding: 0.75rem;
        }

        ::placeholder {
            font-size: 0.875rem;
            color: #a0aec0;
        }

        button {
            display: block;
            width: 100%;
            padding: 0.75rem;
            background-color: #4c51bf;
            color: white;
            border: none;
            border-radius: 0.375rem;
            font-size: 1rem;
            font-weight: 600;
            text-align: center;
            cursor: pointer;
        }

            button:hover {
                background-color: #434190;
            }
    </style>
    <style>
        label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: #4A5568; /* Màu chữ xám đậm */
        }

        input, textarea, select {
            width: 100%;
            padding: 12px 16px;
            font-size: 16px;
            border: 1px solid #E2E8F0; /* Màu viền nhẹ */
            border-radius: 8px;
            margin-bottom: 20px;
            transition: border-color 0.2s;
        }

            input:focus, textarea:focus, select:focus {
                border-color: #3182CE; /* Đổi màu viền khi focus */
                outline: none;
            }

        button {
            width: 100%;
            padding: 12px 16px;
            font-size: 16px;
            background-color: #4C51BF; /* Màu nền nút */
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }

            button:hover {
                background-color: #434190; /* Đổi màu khi hover */
            }
    </style>
</head>
<body>
    <div class="flex items-center min-h-screen p-6 bg-white">
        <div class="flex-1 h-full max-w-4xl mx-auto overflow-hidden bg-white rounded-lg shadow-xl">
            <div class="flex flex-col overflow-y-auto md:flex-row">
                <!-- Image Section -->
                <div class="h-32 md:h-auto md:w-1/2">
                    <img aria-hidden="true"
                         class="object-cover w-full h-full"
                         src="~/img/haha.jpg"
                         alt="Đăng ký Cá Koi" />
                </div>

                <!-- Form Section -->
                <div class="flex items-center justify-center p-6 sm:p-12 md:w-1/2">
                    <div class="w-full">
                        <h1 class="mb-4 text-2xl font-bold text-gray-800">
                            Đăng ký Cá Koi
                        </h1>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="mb-4 text-sm text-green-600">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="mb-4 text-sm text-red-600">
                                @TempData["ErrorMessage"]
                            </div>
                        }

                        <form method="post">
                            <!-- Name -->
                            <label class="block mt-4 text-sm">
                                <span class="text-lg font-semibold text-gray-800">Tên cá Koi</span>
                                <input asp-for="KoiName" placeholder="Nhập tên cá Koi" required />
                            </label>

                            <!-- Breed -->
                            <label class="block mt-4 text-sm">
                                <span class="text-lg font-semibold text-gray-800">Giống cá Koi</span>
                                <input asp-for="KoiBreed" placeholder="Nhập giống cá Koi" required />
                            </label>

                            <!-- Size -->
                            <label class="block mt-4 text-sm">
                                <span class="text-lg font-semibold text-gray-800">Kích thước</span>
                                <input asp-for="KoiSize" type="number" placeholder="Nhập kích thước (cm)" required />
                            </label>

                            <!-- Color -->
                            <label class="block mt-4 text-sm">
                                <span class="text-lg font-semibold text-gray-800">Màu sắc</span>
                                <input asp-for="KoiColor" placeholder="Nhập màu sắc" required />
                            </label>

                            <!-- GPA -->
                            <label class="block mt-4 text-sm">
                                <span class="text-lg font-semibold text-gray-800">GPA</span>
                                <input asp-for="KoiGPA" type="number" step="0.01" placeholder="Nhập GPA" required />
                            </label>

                            <!-- Email -->
                            <label class="block mt-4 text-sm">
                                <span class="text-lg font-semibold text-gray-800">Email</span>
                                <input asp-for="Email" type="email" placeholder="Nhập email" required />
                            </label>

                            <!-- Submit Button -->
                            <button type="submit" class="mt-6">
                                Đăng ký
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
