@page
@{
    Layout = null;
    ViewData["Title"] = "Liên Hệ Hỗ Trợ";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liên Hệ Hỗ Trợ</title>
    <link rel="stylesheet" href="~/css/Menu/Menu.css">
</head>

<body>
    <button class="back-button" onclick="window.history.back()">Trở về</button>
    <main id="main">
        <div class="row">
            <div class="col">
                <div class="main-1">
                    <h1>Liên Hệ Hỗ Trợ</h1>
                    <p>Chúng tôi sẵn sàng hỗ trợ bạn trong mọi vấn đề. Vui lòng liên hệ qua các kênh dưới đây.</p>
                    <div class="title-text-decoration">
                    </div>
                </div>
            </div>
        </div>
        <div class="main-2">
            <div class="row">
                <div class="col">
                    <div class="col-1">
                        <a class="col-1" href="#">
                            <p><img src="IMG/phone.png" alt=""></p>
                            <div class="main-1 box">
                                <p>GỌI ĐIỆN HỖ TRỢ</p>
                                <p>Hotline: 0123 456 789</p>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col">
                    <div class="col-1">
                        <a class="col-1" href="#">
                            <p><img src="IMG/email.png" alt=""></p>
                            <div class="main-1 box">
                                <p>EMAIL HỖ TRỢ</p>
                                <p>info@koiworld.vn</p>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col">
                    <div class="col-1">
                        <a class="col-1" href="#">
                            <p><img src="IMG/facebook.png" alt=""></p>
                            <div class="main-1 box">
                                <p>FACEBOOK</p>
                                <p>https://www.facebook.com/KoiFish05</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
    </main>
    <footer id="footer">
        <div class="footer">
            <div class="footer-thongtin">
                <h2>Khái Quát</h2>
                <p style="text-align: justify;">
                    Koi World là một trong những thương hiệu uy tín hàng đầu chuyên cung cấp các giống cá Koi chất lượng cao, mang lại giá trị và vẻ đẹp cho hồ cá của bạn. Chúng tôi không chỉ cung cấp các giống cá Koi Nhật Bản, mà còn tư vấn và hỗ trợ về cách chăm sóc, thiết kế hồ cá theo phong thủy để mang lại tài lộc và sự thịnh vượng cho gia đình bạn.
                </p>
            </div>
            <div class="footer-thongtin">
                <h2>Hoạt Động</h2>
                <div>
                    <ul>
                        <li><img src="IMG/icon-arrowright.png" alt="">Về Koi World</li>
                        <li><img src="IMG/icon-arrowright.png" alt="">Tuyển dụng</li>
                        <li><img src="IMG/icon-arrowright.png" alt="">Sự kiện và triển lãm cá Koi</li>
                        <li><img src="IMG/icon-arrowright.png" alt="">Báo chí nói về Koi World</li>
                    </ul>
                </div>
            </div>
            <div class="footer-thongtin">
                <h2>Thông tin hữu ích</h2>
                <div>
                    <ul>
                        <li><img src="IMG/icon-arrowright.png" alt=""><a href="#"> Hướng dẫn mua hàng</a></li>
                        <li><img src="IMG/icon-arrowright.png" alt=""><a href="#"> Chính sách đổi trả</a></li>
                        <li><img src="IMG/icon-arrowright.png" alt=""><a href="#"> Điều khoản sử dụng</a></li>
                        <li><img src="IMG/icon-arrowright.png" alt=""><a href="#"> Chính sách bảo mật</a></li>
                        <li><img src="IMG/icon-arrowright.png" alt=""><a href="#"> Bản quyền hình ảnh</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-thongtin">
                <h2>Thông tin liên lạc</h2>
                <div id="ketnoi">
                    CÔNG TY TNHH KOI WORLD<br>
                    Điện thoại: 0123 456 789 (Hotline)<br>
                    Email: info@koiworld.vn<br>
                    Địa chỉ: 123 Đường Cá Koi, Thành phố Cá Koi<br>
                    Giấy phép kinh doanh: 52-009/2021/TCDL-GP<br>
                </div>
                <div id="ketnoi">
                   
                </div>
            </div>
        </div>
    </footer>
    <script src="https://kit.fontawesome.com/bcd15b30db.js" crossorigin="anonymous"></script>
    <script src="script.js"></script>
</body>

</html>
